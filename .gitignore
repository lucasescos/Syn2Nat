# Security & credentials
.env
*.env
cookies.txt
*apikey*
*.key
*.pem

# Dependencies
node_modules/

# Python bytecode & virtual environments
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
ENV/

# Large neural representations & local caches (~49 GB)
bindpred/representations/
data/cache/

# 3D Structure coordinates, PAE error matrices & run ledgers (~8 GB)
structures/pdbs/
structures/pae/
structures/pilot_*/
structures/cofolding_state.jsonl
*.pdb

# Bulk biological databases & raw dumps (>100MB per file)
data/pfam/
data/raw/
data/mappie/
data/targets/raw/

# Screening batch intermediate chunks & heavy track tables
data/screening/*batches/
data/screening/*status.json
data/screening/*significant_tracks.parquet

# Literature PDFs & heavy supplementary spreadsheets
literature/*.pdf
literature/supplementary/

# External cloned repositories
mappie/

# High-count interface contacts & rendering scripts (summaries preserved in reports/)
reports/interfaces/

# Operating system artifacts & editor caches
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.log
